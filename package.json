{
  "name": "@investifi/tile-bridge",
  "version": "0.1.1",
  "description": "Host side of the InvestiFi tile postMessage contract",
  "license": "MIT",
  "author": "InvestiFi, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CryptoFi-LLC/investifi-tile-bridge.git"
  },
  "homepage": "https://github.com/CryptoFi-LLC/investifi-tile-bridge#readme",
  "bugs": {
    "url": "https://github.com/CryptoFi-LLC/investifi-tile-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --minify --format=esm --target=es2019 --outfile=dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2"
  }
}
